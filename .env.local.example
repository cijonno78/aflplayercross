NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The site's public address and contact email (used in the sitemap, share text and pages).
NEXT_PUBLIC_SITE_URL=https://aflplayercross.com
NEXT_PUBLIC_CONTACT_EMAIL=admin@aflplayercross.com

# Optional -- Google Search Console HTML-tag verification code for this site.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional -- ads are fully disabled until this is set.
# See components/AdSenseScript.tsx for where to find it in your Google account.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Optional -- Google Analytics is fully disabled until this is set.
# See components/GoogleAnalyticsScript.tsx for where to find it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
